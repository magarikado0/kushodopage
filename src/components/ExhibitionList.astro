---
import type { Exhibition } from '~/types/content';
import { formatDateRange, yearOf } from '~/libs/format';

interface Props {
  exhibitions: Exhibition[];
}

const { exhibitions } = Astro.props;
---

<ul class="ex-list">
  {
    exhibitions.length === 0 ? (
      <li class="empty">書展情報はまだありません。</li>
    ) : (
      exhibitions.map((exhibition) => (
        <li class="ex-item">
          <a class="ex-link" href={`/exhibitions/${exhibition.id}`}>
            <div class="ex-meta">
              <div class="ex-year">{yearOf(exhibition.startDate)}</div>
              <div class="ex-venue">
                {exhibition.venue}
                {exhibition.address ? <span>　{exhibition.address}</span> : null}
              </div>
            </div>
            <div class="ex-body">
              <h3 class="ex-title">{exhibition.title}</h3>
              <div class="ex-date">
                {formatDateRange(exhibition.startDate, exhibition.endDate)}
              </div>
              <p class="ex-description">{exhibition.description}</p>
            </div>
          </a>
        </li>
      ))
    )
  }
</ul>

<style>
  .ex-list {
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .ex-item {
    border-bottom: 1px solid var(--color-line);
  }

  .ex-link {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 2rem;
    padding: 1.8rem 0.25rem;
    align-items: start;
  }

  .ex-meta {
    padding-top: 0.3rem;
  }

  .ex-year {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: 0.03em;
    line-height: 1;
  }

  .ex-venue {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    color: var(--color-faint);
    margin-top: 0.5rem;
    letter-spacing: 0.08em;
    line-height: 1.6;
  }

  .ex-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-ink);
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .ex-link:hover .ex-title {
    color: var(--color-primary);
  }

  .ex-date {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text);
    margin: 0.5rem 0 0.8rem;
    letter-spacing: 0.05em;
  }

  .ex-description {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.85;
    color: var(--color-muted);
    letter-spacing: 0.03em;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .empty {
    padding: 2.5rem 0;
    color: var(--color-faint);
    font-family: var(--font-sans);
    font-size: 14px;
    text-align: center;
  }

  @media (max-width: 760px) {
    .ex-link {
      grid-template-columns: 1fr;
      gap: 0.6rem 0.8rem;
      padding: 1.3rem 0.2rem;
    }

    .ex-meta {
      display: flex;
      align-items: baseline;
      gap: 0.8rem;
      padding-top: 0;
    }

    .ex-year {
      font-size: 22px;
    }

    .ex-venue {
      margin-top: 0;
      font-size: 11px;
    }

    .ex-title {
      font-size: 16px;
    }

    .ex-date {
      font-size: 12px;
      margin: 0.4rem 0 0.6rem;
    }

    .ex-description {
      font-size: 12.5px;
      line-height: 1.75;
    }
  }
</style>
