---
import { formatDateRange } from '~/libs/format';
import { getHeroExhibition } from '~/libs/microcms';
import InkSplash from '~/components/InkSplash.astro';

const hero = await getHeroExhibition();
const exhibition = hero?.exhibition;
---

<div class="hero-band on-shu">
  <InkSplash color="var(--color-shu-deep)" seed={11} blots={5} />
  <InkSplash color="#ffffff" opacity={0.55} seed={42} blots={3} />

  <section class="hero">
    <div class="hero-visual">
      <img
        class="hero-image"
        src="/H30_shoka_header.jpg"
        alt="書展会場に展示された書作品"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <div class="hero-inner">
      <div class="hero-text">
        <h1 class="hero-title">京都大学書道部</h1>
        <p class="hero-lead">
          漢字・かな・篆刻、古典の臨書から創作まで。<br />
          水曜と土曜に西部課外活動棟で練習しています。<br />
          経験は問いません。
        </p>
        <p class="hero-links">
          <a href="/about#join">入部・見学について</a>
          <a href="/about">部の紹介</a>
        </p>
      </div>

      <div class="hero-next">
        <h2 class="hero-next-label">{hero && !hero.upcoming ? '前回の書展' : '次回の書展'}</h2>
        {
          exhibition ? (
            <>
              <p class="hero-next-title">
                <a href={`/exhibitions/${exhibition.id}`}>{exhibition.title}</a>
              </p>
              <p class="hero-next-meta">
                {formatDateRange(exhibition.startDate, exhibition.endDate)}
                <br />
                {exhibition.venue}
                {exhibition.address ? `（${exhibition.address}）` : ''}
              </p>
            </>
          ) : (
            <p class="hero-next-meta">日程が決まり次第お知らせします。</p>
          )
        }
      </div>
    </div>
  </section>
</div>

<style>
  /* 朱色の面と飛沫は画面幅いっぱい。中身の配置は従来どおり */
  .hero-band {
    position: relative;
    overflow: hidden;
  }

  .hero {
    position: relative;
    width: 100%;
    max-width: calc(var(--content-width) + var(--gutter) + var(--gutter));
    margin: 0 auto;
    padding: 2rem var(--gutter) 0;
  }

  .hero-visual {
    background: #c9c2b4;
    overflow: hidden;
  }

  .hero-image {
    width: 100%;
    height: clamp(240px, 42vw, 460px);
    object-fit: cover;
    object-position: center 40%;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: 2.5rem;
    padding: 2.25rem 0 3rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.7rem, 3.2vw, 2.2rem);
    line-height: 1.3;
    letter-spacing: 0.06em;
    color: var(--color-ink);
  }

  .hero-lead {
    margin-top: 1rem;
    font-size: 15px;
    line-height: 1.9;
    letter-spacing: 0.04em;
    color: var(--color-text);
    word-break: auto-phrase;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.25rem;
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .hero-links a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  .hero-links a:hover {
    text-decoration: none;
  }

  .hero-next {
    padding-left: 2rem;
    border-left: 1px solid var(--color-line);
  }

  .hero-next-label {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .hero-next-title {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    line-height: 1.4;
  }

  .hero-next-title a:hover {
    color: var(--color-primary);
  }

  .hero-next-meta {
    margin-top: 0.5rem;
    font-size: 14px;
    line-height: 1.8;
    color: var(--color-text);
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 1rem;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding: 1.5rem 0 2.25rem;
    }

    .hero-lead {
      font-size: 14px;
    }

    .hero-next {
      padding: 1.25rem 0 0;
      border-left: 0;
      border-top: 1px solid var(--color-line);
    }
  }
</style>
