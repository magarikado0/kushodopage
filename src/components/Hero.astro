---
import { formatDateRange } from '~/libs/format';
import { getHeroExhibition } from '~/libs/microcms';
import InkSplash from '~/components/InkSplash.astro';

const hero = await getHeroExhibition();
const exhibition = hero?.exhibition;
---

<section class="hero on-shu">
  <InkSplash color="var(--color-shu-deep)" seed={11} blots={5} />
  <InkSplash color="#ffffff" opacity={0.55} seed={42} blots={3} />

  <div class="hero-inner">
    <div class="hero-text">
      <h1 class="hero-title">京都大学<br />書道部</h1>
      <p class="hero-lead">
        漢字・かな・篆刻、古典の臨書から創作まで。<br />
        水曜と土曜に西部課外活動棟で練習しています。<br />
        経験は問いません。
      </p>
      <p class="hero-links">
        <a href="/about#join">入部・見学について</a>
        <a href="/about">部の紹介</a>
      </p>

      <div class="hero-next">
        <h2 class="hero-next-label">{hero && !hero.upcoming ? '前回の書展' : '次回の書展'}</h2>
        {
          exhibition ? (
            <p class="hero-next-body">
              <a class="hero-next-title" href={`/exhibitions/${exhibition.id}`}>
                {exhibition.title}
              </a>
              <span>
                {formatDateRange(exhibition.startDate, exhibition.endDate)}　{exhibition.venue}
              </span>
            </p>
          ) : (
            <p class="hero-next-body">日程が決まり次第お知らせします。</p>
          )
        }
      </div>
    </div>

    <div class="hero-visual">
      <img
        class="hero-image"
        src="/H30_shoka_header.jpg"
        alt="書展会場に展示された書作品"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 3rem;
    width: 100%;
    max-width: calc(var(--content-width) + var(--gutter) + var(--gutter));
    margin: 0 auto;
    padding: 4.5rem var(--gutter) 5rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.8rem, 7vw, 5.6rem);
    line-height: 1.15;
    letter-spacing: 0.08em;
  }

  .hero-lead {
    margin-top: 1.5rem;
    font-size: 15px;
    line-height: 1.9;
    letter-spacing: 0.04em;
    word-break: auto-phrase;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.25rem;
    font-size: 15px;
    font-weight: 500;
  }

  .hero-links a,
  .hero-next-title {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  .hero-links a:hover,
  .hero-next-title:hover {
    text-decoration: none;
  }

  .hero-next {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
    max-width: 30rem;
  }

  .hero-next-label {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .hero-next-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 0.4rem;
    font-size: 14px;
    line-height: 1.7;
  }

  .hero-next-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  /* 写真は白い余白で縁取り、掛け軸のように見せる */
  .hero-visual {
    background: #fff;
    padding: 10px;
  }

  .hero-image {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 30% center;
  }

  @media (max-width: 760px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2.5rem var(--gutter) 3rem;
    }

    .hero-lead {
      font-size: 14px;
    }

    .hero-image {
      aspect-ratio: 4 / 3;
    }
  }
</style>
