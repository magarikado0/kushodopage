---
import { formatDateRange } from '~/libs/format';
import { getHeroExhibition } from '~/libs/microcms';
import { getSettings, lines } from '~/libs/settings';

const [hero, settings] = await Promise.all([getHeroExhibition(), getSettings()]);
const exhibition = hero?.exhibition;
// microCMS の画像は表示に十分な大きさの WebP で読み込む（手元の画像はそのまま）
const slides = settings.heroImages.map((image) => ({
  src: image.url.startsWith('https://images.microcms-assets.io/')
    ? `${image.url}?w=1600&fm=webp`
    : image.url,
  alt: image.alt || '京都大学書道部の活動の様子',
}));
---

<section class="hero">
  <div class="hero-visual" data-interval="5000">
    {
      slides.map((slide, i) => (
        <img
          class:list={['hero-image', { 'is-active': i === 0 }]}
          src={slide.src}
          alt={slide.alt}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          decoding="async"
          aria-hidden={i === 0 ? undefined : 'true'}
        />
      ))
    }
    {
      slides.length > 1 && (
        <div class="hero-dots">
          {slides.map((slide, i) => (
            <button
              type="button"
              class:list={['hero-dot', { 'is-active': i === 0 }]}
              aria-label={`${i + 1}枚目の写真を表示：${slide.alt}`}
              aria-current={i === 0 ? 'true' : undefined}
            />
          ))}
        </div>
      )
    }
  </div>

  <div class="hero-next">
    <h2 class="hero-next-label">{hero && !hero.upcoming ? '前回の書展' : '次回の書展'}</h2>
    {
      exhibition ? (
        <div class:list={['hero-next-body', { 'has-poster': exhibition.heroImage?.url }]}>
          {exhibition.heroImage?.url && (
            <a class="hero-next-poster" href={`/exhibitions/${exhibition.id}`}>
              <img
                src={`${exhibition.heroImage.url}?w=480&fm=webp`}
                alt={`${exhibition.title} ポスター`}
                loading="eager"
                decoding="async"
              />
            </a>
          )}
          <div class="hero-next-text">
            <p class="hero-next-title">
              <a href={`/exhibitions/${exhibition.id}`}>{exhibition.title}</a>
            </p>
            <p class="hero-next-meta">
              {formatDateRange(exhibition.startDate, exhibition.endDate)}
              <br />
              {exhibition.venue}
              {exhibition.address ? `（${exhibition.address}）` : ''}
            </p>
          </div>
        </div>
      ) : (
        <p class="hero-next-meta">日程が決まり次第お知らせします。</p>
      )
    }
  </div>

  <div class="hero-text">
    <h1 class="hero-title">京都大学書道部</h1>
    <p class="hero-lead">
      {
        lines(settings.heroLead).map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </p>
    <p class="hero-links">
      <a class="hero-btn is-main" href="/about#join">入部・見学について</a>
      <a class="hero-btn" href="/about">部の紹介</a>
    </p>
  </div>
</section>

<script>
  // トップの写真を順に切り替える。マウスを乗せている間・動きを減らす設定の端末では止める
  for (const visual of document.querySelectorAll<HTMLElement>('.hero-visual')) {
    const images = [...visual.querySelectorAll<HTMLImageElement>('.hero-image')];
    const dots = [...visual.querySelectorAll<HTMLButtonElement>('.hero-dot')];
    if (images.length < 2) continue;

    let index = 0;
    const show = (next: number) => {
      index = (next + images.length) % images.length;
      images.forEach((img, i) => {
        img.classList.toggle('is-active', i === index);
        img.toggleAttribute('aria-hidden', i !== index);
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
        if (i === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const interval = Number(visual.dataset.interval) || 5000;
    let timer: number | undefined;
    const start = () => {
      if (reduceMotion) return;
      stop();
      timer = window.setInterval(() => show(index + 1), interval);
    };
    const stop = () => window.clearInterval(timer);

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        start();
      }),
    );
    visual.addEventListener('mouseenter', stop);
    visual.addEventListener('mouseleave', start);

    // スマホは左右のスワイプでも切り替える
    let touchX: number | null = null;
    visual.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
    visual.addEventListener('touchend', (e) => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      touchX = null;
      if (Math.abs(dx) > 40) {
        show(index + (dx < 0 ? 1 : -1));
        start();
      }
    });

    start();
  }
</script>

<style>
  /*
   * 左：写真、その下に部名・紹介文・ボタン
   * 右：前回／次回の書展（左の列の高さいっぱいに通す）
   */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    grid-template-areas:
      'visual next'
      'text next';
    column-gap: 2.5rem;
    width: 100%;
    max-width: calc(var(--content-width) + var(--gutter) + var(--gutter));
    margin: 0 auto;
    padding: 2rem var(--gutter) 0;
  }

  .hero-visual {
    grid-area: visual;
    position: relative;
    min-height: clamp(240px, 26vw, 360px);
    background: #e9e4dc;
    overflow: hidden;
    border-radius: 4px;
  }

  /* 写真は重ねて置き、表示中の1枚だけ不透明にしてゆっくり切り替える */
  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .hero-image.is-active {
    opacity: 1;
  }

  .hero-dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.75rem;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }

  .hero-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.55);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25);
  }

  .hero-dot.is-active {
    background: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image {
      transition: none;
    }
  }

  /*
   * カード：白いページの上に置いた和紙のような1枚。
   * 上辺の朱の線と影はヘッダーとそろえ、同じ仲間に見せる。
   */
  .hero-next {
    grid-area: next;
    align-self: start;
    margin-bottom: 3rem;
    padding: 1.25rem 1.5rem 1.5rem;
    background: #fbf9f6; /* パソコンでは面積が大きいので、ごく薄く */
    border-top: 3px solid var(--color-rule);
    border-radius: 0 0 4px 4px;
    box-shadow: 0 4px 12px rgba(28, 24, 20, 0.12);
  }

  .hero-next-label {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-primary);
  }

  .hero-next-poster {
    display: block;
    margin-top: 0.75rem;
  }

  .hero-next-poster img {
    display: block;
    width: 75%;
    height: auto;
    margin-inline: auto;
    border-radius: 4px;
  }

  .hero-next-title {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    line-height: 1.4;
  }

  .hero-next-title a:hover {
    color: var(--color-primary);
  }

  .hero-next-meta {
    margin-top: 0.4rem;
    font-size: 14px;
    line-height: 1.8;
    color: var(--color-text);
  }

  .hero-text {
    grid-area: text;
    padding: 2.25rem 0 3rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.7rem, 3.2vw, 2.2rem);
    line-height: 1.3;
    letter-spacing: 0.06em;
    color: var(--color-ink);
  }

  .hero-lead {
    margin-top: 1rem;
    font-size: 15px;
    line-height: 1.9;
    letter-spacing: 0.04em;
    color: var(--color-text);
    word-break: auto-phrase;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .hero-btn {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border: 1px solid var(--color-primary);
    border-radius: 4px;
    color: var(--color-primary);
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .hero-btn.is-main {
    background: var(--color-primary);
    color: #fff;
    font-weight: 500;
  }

  .hero-btn:hover {
    background: var(--color-primary);
    color: #fff;
  }

  .hero-btn.is-main:hover {
    background: transparent;
    color: var(--color-primary);
  }

  /* スマホ：写真 → 部名と紹介文 → ボタン → 書展 の順に縦に並べる */
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-areas:
        'visual'
        'text'
        'next';
      padding-top: 1rem;
    }

    .hero-visual {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }

    .hero-text {
      padding: 1.5rem 0 0;
    }

    .hero-lead {
      font-size: 14px;
    }

    .hero-links {
      margin-top: 1.25rem;
    }

    .hero-next {
      margin: 1.75rem 0 2.25rem;
      padding: 1rem 1.1rem 1.1rem;
      background: #f6f2ec;
    }

    /* ポスターは小さくして、書展名の横に置く */
    .hero-next-body.has-poster {
      display: grid;
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: 1.1rem;
      align-items: center;
      margin-top: 0.75rem;
    }

    .hero-next-poster {
      margin-top: 0;
    }

    .hero-next-poster img {
      width: 100%;
      height: auto;
    }

    .has-poster .hero-next-title {
      margin-top: 0;
      font-size: 1.25rem;
    }

    .has-poster .hero-next-meta {
      font-size: 14px;
    }
  }
</style>
