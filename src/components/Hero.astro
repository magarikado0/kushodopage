---
import { formatDateRange } from '~/libs/format';
import { getFeaturedExhibition } from '~/libs/microcms';

const exhibition = await getFeaturedExhibition();
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-meta">
      <span class="hero-eyebrow">書道部について</span>
      <span class="hero-divider" aria-hidden="true"></span>
      <span class="hero-en">Kyoto University Calligraphy Club</span>
    </div>

    <h1 class="hero-title">
      京都大学書道部
      <span class="hero-sub">漢字・かな・篆刻、古典から創作まで。</span>
    </h1>

    {
      exhibition ? (
        <a class="hero-feature" href={`/exhibitions/${exhibition.id}`}>
          <span class="hero-feature-label">次回の書展</span>
          <span class="hero-feature-title">{exhibition.title}</span>
          <span class="hero-feature-meta">
            <span class="hero-feature-date">
              {formatDateRange(exhibition.startDate, exhibition.endDate)}
            </span>
            <span class="hero-feature-venue">
              {exhibition.venue}
              {exhibition.address ? `　${exhibition.address}` : ''}
            </span>
          </span>
          <span class="hero-feature-arrow" aria-hidden="true">→</span>
        </a>
      ) : (
        <div class="hero-feature is-empty">
          <span class="hero-feature-label">次回の書展</span>
          <span class="hero-feature-title">未定</span>
          <span class="hero-feature-meta">次回の書展は現在調整中です。</span>
        </div>
      )
    }
  </div>

  <div class="hero-visual">
    <img
      class="hero-image"
      src="/H30_shoka_header.jpg"
      alt="書展会場に展示された書作品"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;
    border-bottom: 1px solid var(--color-line);
    min-height: 380px;
    position: relative;
    z-index: 1;
  }

  .hero-inner {
    padding: 3rem var(--gutter) 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.4rem;
    position: relative;
  }

  /* 朱の縦アクセントライン */
  .hero-inner::before {
    content: '';
    position: absolute;
    left: 0;
    top: 3rem;
    bottom: 2.25rem;
    width: 2px;
    background: var(--color-primary);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .hero-eyebrow {
    color: var(--color-primary);
    font-weight: 500;
  }

  .hero-divider {
    width: 28px;
    height: 1px;
    background: var(--color-line);
  }

  .hero-en {
    font-size: 11px;
    letter-spacing: 0.12em;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.7rem, 3.2vw, 2.2rem);
    line-height: 1.3;
    letter-spacing: 0.06em;
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .hero-sub {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    line-height: 1.7;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .hero-feature {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 0.5rem 1rem;
    padding: 1.4rem 1.5rem 1.4rem 1.6rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-primary);
    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }

  .hero-feature:hover {
    background: #fff;
    transform: translateY(-2px);
  }

  .hero-feature-label {
    grid-column: 1;
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--color-primary);
    font-weight: 500;
  }

  .hero-feature-title {
    grid-column: 1;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-ink);
    line-height: 1.4;
  }

  .hero-feature-meta {
    grid-column: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-muted);
    letter-spacing: 0.03em;
    line-height: 1.7;
  }

  .hero-feature-date {
    color: var(--color-text);
    font-weight: 500;
  }

  .hero-feature-arrow {
    grid-column: 2;
    grid-row: 1 / -1;
    align-self: center;
    font-size: 18px;
    color: var(--color-primary);
    transition: transform 0.25s ease;
  }

  .hero-feature:hover .hero-feature-arrow {
    transform: translateX(4px);
  }

  /* 右側ビジュアル */
  .hero-visual {
    position: relative;
    background: #c9c2b4;
    overflow: hidden;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    min-height: 380px;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.92);
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hero-inner {
      order: 2;
      padding: 2rem var(--gutter) 2.2rem;
      gap: 1.3rem;
    }

    .hero-inner::before {
      top: 2rem;
      bottom: 2.2rem;
    }

    .hero-title {
      gap: 0.6rem;
    }

    .hero-feature {
      padding: 1.1rem 1.2rem 1.1rem 1.3rem;
    }

    .hero-visual {
      order: 1;
      padding: 0.6rem var(--gutter) 0;
      background: transparent;
    }

    .hero-image {
      min-height: 200px;
      border: 1px solid var(--color-line);
    }
  }
</style>
