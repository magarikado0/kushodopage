---
import { formatDateRange } from '~/libs/format';
import { getHeroExhibition } from '~/libs/microcms';

const hero = await getHeroExhibition();
const exhibition = hero?.exhibition;
---

<section class="hero">
  <div class="hero-visual">
    <img
      class="hero-image"
      src="/H30_shoka_header.jpg"
      alt="書展会場に展示された書作品"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="hero-inner">
    <div class="hero-text">
      <h1 class="hero-title">京都大学書道部</h1>
      <p class="hero-lead">
        漢字・かな・篆刻、古典の臨書から創作まで。<br />
        水曜と土曜に西部課外活動棟で練習しています。<br />
        経験は問いません。
      </p>
      <p class="hero-links">
        <a class="hero-btn is-main" href="/about#join">入部・見学について</a>
        <a class="hero-btn" href="/about">部の紹介</a>
      </p>
    </div>

    <div class="hero-next">
      <h2 class="hero-next-label">{hero && !hero.upcoming ? '前回の書展' : '次回の書展'}</h2>
      {
        exhibition ? (
          <div class:list={['hero-next-body', { 'has-poster': exhibition.heroImage?.url }]}>
            {exhibition.heroImage?.url && (
              <a class="hero-next-poster" href={`/exhibitions/${exhibition.id}`}>
                <img
                  src={`${exhibition.heroImage.url}?w=360&fm=webp`}
                  alt={`${exhibition.title} ポスター`}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}
            <div>
              <p class="hero-next-title">
                <a href={`/exhibitions/${exhibition.id}`}>{exhibition.title}</a>
              </p>
              <p class="hero-next-meta">
                {formatDateRange(exhibition.startDate, exhibition.endDate)}
                <br />
                {exhibition.venue}
                {exhibition.address ? `（${exhibition.address}）` : ''}
              </p>
            </div>
          </div>
        ) : (
          <p class="hero-next-meta">日程が決まり次第お知らせします。</p>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    width: 100%;
    max-width: calc(var(--content-width) + var(--gutter) + var(--gutter));
    margin: 0 auto;
    padding: 2rem var(--gutter) 0;
  }

  .hero-visual {
    background: #c9c2b4;
    overflow: hidden;
  }

  .hero-image {
    width: 100%;
    height: clamp(240px, 42vw, 460px);
    object-fit: cover;
    object-position: center 40%;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
    gap: 2.5rem;
    padding: 2.25rem 0 3rem;
    border-bottom: 1px solid var(--color-line);
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.7rem, 3.2vw, 2.2rem);
    line-height: 1.3;
    letter-spacing: 0.06em;
    color: var(--color-ink);
  }

  .hero-lead {
    margin-top: 1rem;
    font-size: 15px;
    line-height: 1.9;
    letter-spacing: 0.04em;
    color: var(--color-text);
    word-break: auto-phrase;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  /* ボタンも「朱の上に置いた白い紙」の小さな1枚として作る（角の丸みは紙と同じ） */
  .hero-btn {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border: 1px solid #fff;
    border-radius: 4px;
    color: #fff;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .hero-btn.is-main {
    background: #fff;
    color: var(--color-shu);
    font-weight: 500;
  }

  .hero-btn:hover {
    background: #fff;
    color: var(--color-shu);
  }

  .hero-btn.is-main:hover {
    background: transparent;
    color: #fff;
  }

  .hero-next {
    padding-left: 2rem;
    border-left: 1px solid var(--color-line);
  }

  /* 書展のポスターがあれば、書展名の横に小さく添える */
  .hero-next-body.has-poster {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    margin-top: 0.75rem;
  }

  .hero-next-body.has-poster .hero-next-title {
    margin-top: 0;
  }

  .hero-next-poster img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .hero-next-label {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .hero-next-title {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    line-height: 1.4;
  }

  .hero-next-title a:hover {
    color: var(--color-primary);
  }

  .hero-next-meta {
    margin-top: 0.5rem;
    font-size: 14px;
    line-height: 1.8;
    color: var(--color-text);
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 1rem;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding: 1.5rem 0 2.25rem;
    }

    .hero-lead {
      font-size: 14px;
    }

    .hero-next {
      padding: 1.25rem 0 0;
      border-left: 0;
      border-top: 1px solid var(--color-line);
    }
  }
</style>
