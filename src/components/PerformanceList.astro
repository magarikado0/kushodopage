---
import type { Performance } from '~/types/content';

interface Props {
  performances: Performance[];
}

const { performances } = Astro.props;
const groups = [
  {
    title: 'NF書道パフォーマンス',
    performances: performances.filter((performance) => {
      const types = Array.isArray(performance.type)
        ? performance.type
        : [performance.type];
      return types.includes('NF書道パフォーマンス');
    }),
  },
  {
    title: '新歓書道パフォーマンス',
    performances: performances.filter((performance) => {
      const types = Array.isArray(performance.type)
        ? performance.type
        : [performance.type];
      return types.includes('新歓書道パフォーマンス');
    }),
  },
] as const;
---

<div class="performance-groups">
  {
    performances.length === 0 ? (
      <p class="empty">書道パフォーマンスの記録は順次掲載します。</p>
    ) : (
      groups.map((group) => (
        <section class="performance-group">
          <h3 class="performance-heading">{group.title}</h3>
          {group.performances.length === 0 ? (
            <p class="empty performance-empty">記録は順次掲載します。</p>
          ) : (
            <div class="performance-list">
              {group.performances.map((performance) => (
                <a
                  class="performance-item"
                  href={performance.url}
                  target="_blank"
                  rel="noreferrer"
                >
                  {performance.year}年
                </a>
              ))}
            </div>
          )}
        </section>
      ))
    )
  }
</div>

<style>
  .performance-groups {
    display: grid;
    gap: 2.75rem;
  }

  .performance-heading {
    margin-bottom: 1.1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .performance-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
  }

  .performance-item {
    font-size: 15px;
    letter-spacing: 0.04em;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .performance-item:hover {
    text-decoration: none;
  }

  .empty {
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 14px;
  }

</style>
