---
import type { Performance } from '~/types/content';

interface Props {
  performances: Performance[];
}

const { performances } = Astro.props;
const groups = [
  {
    title: 'NF書道パフォーマンス',
    performances: performances.filter((performance) => {
      const types = Array.isArray(performance.type)
        ? performance.type
        : [performance.type];
      return types.includes('NF書道パフォーマンス');
    }),
  },
  {
    title: '新歓書道パフォーマンス',
    performances: performances.filter((performance) => {
      const types = Array.isArray(performance.type)
        ? performance.type
        : [performance.type];
      return types.includes('新歓書道パフォーマンス');
    }),
  },
] as const;
---

<div class="performance-groups">
  {
    performances.length === 0 ? (
      <p class="empty">書道パフォーマンスの記録は順次掲載します。</p>
    ) : (
      groups.map((group) => (
        <section class="performance-group">
          <h3 class="performance-heading">{group.title}</h3>
          {group.performances.length === 0 ? (
            <p class="empty performance-empty">記録は順次掲載します。</p>
          ) : (
            <div class="performance-list">
              {group.performances.map((performance) => (
                <a
                  class="performance-item"
                  href={performance.url}
                  target="_blank"
                  rel="noreferrer"
                >
                  <span class="performance-year">{performance.year}</span>
                  <span class="performance-cta" aria-hidden="true">記録を見る ↗</span>
                </a>
              ))}
            </div>
          )}
        </section>
      ))
    )
  }
</div>

<style>
  .performance-groups {
    display: grid;
    gap: 2.75rem;
  }

  .performance-heading {
    margin-bottom: 1.1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .performance-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .performance-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    background: var(--color-paper);
    transition: background 0.2s ease;
  }

  .performance-item:hover {
    background: #fff;
  }

  .performance-year {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-ink);
  }

  .performance-cta {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .empty {
    padding: 2.5rem 1rem;
    color: var(--color-faint);
    font-family: var(--font-sans);
    font-size: 14px;
    text-align: center;
  }

  @media (max-width: 600px) {
    .performance-list {
      grid-template-columns: 1fr;
    }

    .performance-year {
      font-size: 19px;
    }
  }
</style>
