---
/**
 * 墨（朱墨）を飛ばしたような飛沫の背景。
 * 円と細長い滴をランダムに散らし、SVG のノイズフィルターで縁をにじませる。
 * seed を固定しているので、ビルドごとに模様が変わることはない。
 */
interface Props {
  /** 飛沫の色 */
  color?: string;
  /** 不透明度 */
  opacity?: number;
  /** 模様を決める数値。変えると別の飛び散り方になる */
  seed?: number;
  /** 大きな飛沫の数 */
  blots?: number;
  class?: string;
}

const {
  color = '#a52a1c',
  opacity = 1,
  seed = 7,
  blots = 6,
  class: className,
} = Astro.props;

function random(seedValue: number) {
  let t = seedValue >>> 0;
  return () => {
    t += 0x6d2b79f5;
    let r = Math.imul(t ^ (t >>> 15), t | 1);
    r ^= r + Math.imul(r ^ (r >>> 7), r | 61);
    return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = random(seed);
const W = 1200;
const H = 700;

type Shape =
  | { kind: 'circle'; cx: number; cy: number; r: number }
  | { kind: 'drop'; cx: number; cy: number; rx: number; ry: number; angle: number };

const shapes: Shape[] = [];
for (let i = 0; i < blots; i++) {
  const cx = rand() * W;
  const cy = rand() * H;
  const r = 14 + rand() * 42;
  shapes.push({ kind: 'circle', cx, cy, r });

  // 中心から外へ勢いよく伸びる筋。先端に小さな滴が残る
  const streaks = 14 + Math.floor(rand() * 12);
  for (let j = 0; j < streaks; j++) {
    const angle = rand() * Math.PI * 2;
    const len = 18 + rand() * rand() * 140;
    const start = r * (0.6 + rand() * 0.3);
    const mid = start + len / 2;
    shapes.push({
      kind: 'drop',
      cx: cx + Math.cos(angle) * mid,
      cy: cy + Math.sin(angle) * mid,
      rx: len / 2,
      ry: 1 + rand() * (len > 60 ? 3 : 5),
      angle: (angle * 180) / Math.PI,
    });
    if (rand() < 0.6) {
      const tip = start + len + 4 + rand() * 18;
      shapes.push({
        kind: 'circle',
        cx: cx + Math.cos(angle) * tip,
        cy: cy + Math.sin(angle) * tip,
        r: 1.5 + rand() * 4.5,
      });
    }
  }

  // まわりに飛んだ細かい滴
  const droplets = 25 + Math.floor(rand() * 25);
  for (let j = 0; j < droplets; j++) {
    const angle = rand() * Math.PI * 2;
    const dist = r * (1.2 + rand() * 5);
    shapes.push({
      kind: 'circle',
      cx: cx + Math.cos(angle) * dist,
      cy: cy + Math.sin(angle) * dist,
      r: 0.8 + rand() * rand() * 7,
    });
  }
}

// 全体にうっすら散る霧のような粒
for (let i = 0; i < 140; i++) {
  shapes.push({ kind: 'circle', cx: rand() * W, cy: rand() * H, r: 0.5 + rand() * 2.2 });
}

const filterId = `ink-${seed}`;
const round = (n: number) => Math.round(n * 10) / 10;
---

<svg
  class:list={['ink-splash', className]}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <filter id={filterId} x="-10%" y="-10%" width="120%" height="120%">
      <feTurbulence type="fractalNoise" baseFrequency="0.07" numOctaves="2" seed={seed} />
      <feDisplacementMap in="SourceGraphic" scale="9" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </defs>
  <g fill={color} opacity={opacity} filter={`url(#${filterId})`}>
    {
      shapes.map((s) =>
        s.kind === 'circle' ? (
          <circle cx={round(s.cx)} cy={round(s.cy)} r={round(s.r)} />
        ) : (
          <ellipse
            cx={round(s.cx)}
            cy={round(s.cy)}
            rx={round(s.rx)}
            ry={round(s.ry)}
            transform={`rotate(${round(s.angle)} ${round(s.cx)} ${round(s.cy)})`}
          />
        ),
      )
    }
  </g>
</svg>

<style>
  .ink-splash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
