---
import { NAV_ITEMS, SITE } from '~/libs/site';

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<header class="nav">
  <div class="nav-inner">
    <a class="nav-logo" href="/" aria-label={`${SITE.name} トップページ`}>
      <img src="/header.png" alt={SITE.name} />
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="global-navigation"
      aria-label="メニューを開く"
    >
      <span class="nav-toggle-line"></span>
      <span class="nav-toggle-line"></span>
      <span class="nav-toggle-line"></span>
    </button>
    <nav class="nav-links" id="global-navigation" aria-label="グローバルナビゲーション">
      <ul>
        {
          NAV_ITEMS.map((item) => (
            <li class={current === item.href ? 'is-active' : ''}>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: relative;
    z-index: 30;
    background: var(--color-page);
    border-bottom: 1px solid var(--color-line);
  }

  .nav-inner {
    width: 100%;
    max-width: calc(var(--content-width) + var(--gutter) + var(--gutter));
    margin: 0 auto;
    padding: 1.1rem var(--gutter);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-logo {
    display: block;
    flex: 0 1 240px;
  }

  .nav-logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .nav-toggle {
    display: none;
  }

  .nav-links ul {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--color-text);
  }

  /* 下線式ナビ（ホバーで朱の下線が伸びる） */
  .nav-links a {
    position: relative;
    display: inline-block;
    padding: 0.5rem 0.1rem;
    transition: color 0.25s ease;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0.15rem;
    height: 1px;
    background: var(--color-primary);
    transition: right 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-links a:hover {
    color: var(--color-primary);
  }

  .nav-links a:hover::after {
    right: 0;
  }

  .nav-links li.is-active a {
    color: var(--color-primary);
  }

  .nav-links li.is-active a::after {
    right: 0;
  }

  /* 最後の項目（入部案内）だけ朱の塗りボタン */
  .nav-links li:last-child {
    margin-left: 0.5rem;
  }

  .nav-links li:last-child a {
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .nav-links li:last-child a::after {
    display: none;
  }

  .nav-links li:last-child a:hover {
    background: var(--color-primary);
    color: #fff;
  }

  .nav-links li.is-active:last-child a {
    background: var(--color-primary);
    color: #fff;
  }

  @media (max-width: 760px) {
    .nav-inner {
      padding: 0.85rem var(--gutter);
      gap: 0.8rem;
    }

    .nav-logo {
      flex-basis: 180px;
    }

    .nav-toggle {
      display: grid;
      place-content: center;
      gap: 5px;
      width: 42px;
      height: 42px;
      margin-left: auto;
      color: var(--color-ink);
      border: 1px solid var(--color-line);
      background: var(--color-paper);
    }

    .nav-toggle-line {
      display: block;
      width: 18px;
      height: 1px;
      background: currentColor;
      transition:
        transform 0.2s ease,
        opacity 0.2s ease;
    }

    .nav-toggle[aria-expanded='true'] .nav-toggle-line:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }

    .nav-toggle[aria-expanded='true'] .nav-toggle-line:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle[aria-expanded='true'] .nav-toggle-line:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }

    .nav-links {
      display: none;
    }

    .nav-links.is-open {
      display: block;
      position: absolute;
      z-index: 20;
      top: 100%;
      right: 0;
      left: 0;
      background: var(--color-page);
      border-bottom: 1px solid var(--color-line);
      padding: 0.5rem var(--gutter) 1.1rem;
    }

    .nav-links ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      font-size: 13px;
    }

    .nav-links li {
      border-bottom: 1px solid var(--color-line-soft);
    }

    .nav-links li:last-child {
      margin: 0.6rem 0 0;
      border: 0;
    }

    .nav-links li a {
      display: block;
      padding: 0.85rem 0.1rem;
    }

    .nav-links li a::after {
      display: none;
    }

    .nav-links li:last-child a {
      border: 1px solid var(--color-primary);
      text-align: center;
      padding: 0.75rem 0.9rem;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.nav');
  const toggle = nav?.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = nav?.querySelector<HTMLElement>('.nav-links');

  const closeMenu = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'メニューを開く');
    links?.classList.remove('is-open');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'メニューを開く' : 'メニューを閉じる');
    links?.classList.toggle('is-open', !isOpen);
  });

  links?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) closeMenu();
  });

  document.addEventListener('click', (event) => {
    if (nav && !nav.contains(event.target as Node)) closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu();
      toggle?.focus();
    }
  });

  window.matchMedia('(min-width: 761px)').addEventListener('change', closeMenu);
</script>
