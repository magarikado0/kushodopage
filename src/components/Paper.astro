---
/**
 * ページの本文をまとめる枠。
 */
---

<div class="paper-wrap">
  <div class="paper">
    <slot />
  </div>
</div>

<style>
  /* 白背景では紙のまわりに余白を取らず、ほかの部分と左右の位置をそろえる */
  .paper-wrap {
    padding-bottom: 4rem;
  }

  @media (max-width: 760px) {
    .paper-wrap {
      padding-bottom: 2.5rem;
    }
  }
</style>
