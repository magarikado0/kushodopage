---
interface Props {
  title: string;
  /** 「一覧を見る」等のリンク先。未指定ならリンクを表示しない */
  moreHref?: string;
  moreLabel?: string;
  /** 下線を引かない（ページ末尾のセクション用） */
  flush?: boolean;
}

const {
  title,
  moreHref,
  moreLabel = 'すべて見る',
  flush = false,
} = Astro.props;
---

<section class:list={['section', { 'is-flush': flush }]}>
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">{title}</h2>
      {
        moreHref && (
          <a class="section-more" href={moreHref}>
            {moreLabel}
          </a>
        )
      }
    </div>
    <slot />
  </div>
</section>

<style>
  .section {
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .section.is-flush {
    border-bottom: none;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
    gap: 1rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.7rem);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-ink);
    line-height: 1.3;
  }

  .section-more {
    font-size: 13px;
    color: var(--color-primary);
    font-family: var(--font-sans);
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  .section-more:hover {
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .section {
      padding: 2.4rem 0;
    }

    .section-head {
      margin-bottom: 1.4rem;
      gap: 0.7rem;
    }


    .section-more {
      font-size: 12px;
    }
  }
</style>
