---
import type { NewsItem } from '~/types/content';
import { excerpt, formatDate } from '~/libs/format';

interface Props {
  items: NewsItem[];
  /** トップページ向けに本文の抜粋を表示する */
  showDescription?: boolean;
}

const { items, showDescription = false } = Astro.props;
---

<div class="news-list">
  {
    items.length === 0 ? (
      <p class="news-empty">お知らせはまだありません。</p>
    ) : (
      items.map((item) => (
        <a class:list={['news-item', { 'is-rich': showDescription }]} href={`/news/${item.id}`}>
          <span class="news-meta">
            <span class="news-date">{formatDate(item.publishedAt)}</span>
            <span class="news-tag">
              {Array.isArray(item.category) ? item.category.join('・') : item.category}
            </span>
          </span>
          <span class="news-body">
            <span class="news-ttl">{item.title}</span>
            {showDescription && (
              <span class="news-description">
                {item.description?.trim() || excerpt(item.content, 96)}
              </span>
            )}
          </span>
          <span class="news-arrow" aria-hidden="true">→</span>
        </a>
      ))
    )
  }
</div>

<style>
  .news-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-line);
  }

  .news-item {
    display: grid;
    grid-template-columns: 12rem 1fr auto;
    align-items: start;
    gap: 1.5rem;
    padding: 1.3rem 0.25rem;
    border-bottom: 1px solid var(--color-line);
    transition: background 0.2s ease;
  }

  .news-item:hover {
    background: rgba(155, 35, 53, 0.035);
  }

  .news-item.is-rich {
    align-items: center;
    gap: 1.75rem;
    padding: 1.5rem 0.25rem;
  }

  .news-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.1rem;
  }

  .news-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-faint);
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .news-tag {
    align-self: flex-start;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    padding: 2px 8px;
    white-space: nowrap;
  }

  .news-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
  }

  .news-ttl {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-ink);
    line-height: 1.5;
  }

  .news-description {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.8;
    letter-spacing: 0.03em;
    color: var(--color-muted);
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .news-arrow {
    align-self: center;
    font-size: 15px;
    color: var(--color-faint);
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .news-item:hover .news-arrow {
    color: var(--color-primary);
    transform: translateX(3px);
  }

  .news-empty {
    padding: 2.5rem 0;
    color: var(--color-faint);
    font-family: var(--font-sans);
    font-size: 14px;
    text-align: center;
  }

  @media (max-width: 760px) {
    .news-item {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'meta meta'
        'body arrow';
      gap: 0.5rem 0.8rem;
      padding: 1.1rem 0.2rem;
    }

    .news-meta {
      grid-area: meta;
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
    }

    .news-body {
      grid-area: body;
    }

    .news-arrow {
      grid-area: arrow;
      align-self: center;
    }

    .news-date {
      font-size: 11px;
    }

    .news-tag {
      font-size: 10px;
      padding: 1px 6px;
    }

    .news-ttl {
      font-size: 14px;
      line-height: 1.5;
    }

    .news-description {
      font-size: 12px;
      line-height: 1.7;
      -webkit-line-clamp: 3;
    }
  }
</style>
