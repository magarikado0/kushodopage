---
import { NAV_ITEMS, SITE } from '~/libs/site';
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="footer-name">
        <span class="footer-ja">{SITE.name}</span>
        <span class="footer-en">{SITE.nameEn}</span>
      </div>
    </div>

    <nav class="footer-links" aria-label="フッターナビゲーション">
      <ul>
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer-copy">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <span class="footer-domain">{SITE.domain}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-footer-bg);
    color: var(--color-footer-text);
    padding: 2.6rem var(--gutter) 1.8rem;
  }

  .footer-inner {
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .footer-name {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .footer-ja {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-footer-text);
  }

  .footer-en {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.14em;
    color: var(--color-footer-muted);
    text-transform: uppercase;
  }

  .footer-links ul {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    flex-wrap: wrap;
  }

  .footer-links a {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--color-footer-muted);
    transition: color 0.2s ease;
    padding-bottom: 2px;
  }

  .footer-links a:hover {
    color: var(--color-footer-text);
  }

  .footer-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-footer-copy);
  }

  .footer-domain {
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  @media (max-width: 760px) {
    .footer-inner {
      gap: 1.2rem;
    }

    .footer-links ul {
      gap: 1rem;
    }

    .footer-copy {
      align-items: flex-start;
    }
  }
</style>
