---
interface Props {
  title: string;
  /** タイトル下の補足文（任意） */
  lead?: string;
}

const { title, lead } = Astro.props;
---

<section class="page-header">
  <div class="container">
    <h1 class="page-header-title">{title}</h1>
    {lead && <p class="page-header-lead">{lead}</p>}
  </div>
</section>

<style>
  .page-header {
    padding: 3.5rem 0 1.8rem;
    border-bottom: 1px solid var(--color-line);
  }

  .page-header-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.8vw, 2.6rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-ink);
    line-height: 1.3;
  }

  .page-header-lead {
    margin-top: 0.75rem;
    font-size: 14px;
    line-height: 1.8;
    letter-spacing: 0.03em;
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .page-header {
      padding: 2.25rem 0 1.4rem;
    }
  }
</style>
