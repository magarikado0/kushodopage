---
import type { GetStaticPaths } from 'astro';
import Base from '~/layouts/Base.astro';
import Paper from '~/components/Paper.astro';
import { getAllNews, getNewsById } from '~/libs/microcms';
import { formatDate, excerpt } from '~/libs/format';

export const getStaticPaths = (async () => {
  const list = await getAllNews();
  return list.map(({ id }) => ({ params: { id } }));
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const item = id ? await getNewsById(id) : null;

if (!item) {
  return Astro.redirect('/news');
}

// 前後のお知らせ（簡易: 全件取得して位置を探す）
const all = await getAllNews();
const idx = all.findIndex((n) => n.id === item.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

const isHtml = item.content?.includes('<') ?? false;
// microCMS の画像は原寸だと重いので、表示に十分なサイズの WebP で読み込む
const content = isHtml
  ? item.content.replace(
      /(<img\b[^>]*\bsrc=")(https:\/\/images\.microcms-assets\.io\/[^"?]+)"/g,
      '$1$2?w=1600&fm=webp"',
    )
  : '';
---

<Base title={item.title} description={excerpt(item.content, 120)} current="/news">
  <Paper>
    <article class="article">
      <div class="container article-head">
        <a class="article-back" href="/news">お知らせ一覧に戻る</a>
        <div class="article-meta">
          <span class="news-date">{formatDate(item.publishedAt)}</span>
          <span class="news-tag">
            {Array.isArray(item.category) ? item.category.join('・') : item.category}
          </span>
        </div>
        <h1 class="article-title">{item.title}</h1>
      </div>

      <div class="container">
        {isHtml && <div class="article-body" set:html={content} />}
        {
          !isHtml && item.content ? (
            <div class="article-body">
              {item.content.split('\n').map((line) => (
                <p>{line}</p>
              ))}
            </div>
          ) : null
        }
      </div>

      <nav class="container article-nav">
        {
          prev ? (
            <a class="article-nav-item is-prev" href={`/news/${prev.id}`}>
              <span>前の記事</span>
              <strong>{prev.title}</strong>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a class="article-nav-item is-next" href={`/news/${next.id}`}>
              <span>次の記事</span>
              <strong>{next.title}</strong>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </article>
  </Paper>
</Base>

<style>
  .article {
    padding: 3rem 0 4rem;
  }

  .article-back {
    display: inline-block;
    font-size: 13px;
    color: var(--color-primary);
    font-family: var(--font-sans);
    letter-spacing: 0.04em;
    margin-bottom: 2rem;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .news-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-faint);
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .news-tag {
    font-size: 11px;
    color: var(--color-muted);
    letter-spacing: 0.06em;
    font-family: var(--font-sans);
  }

  .article-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.1rem);
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1.5;
    color: var(--color-ink);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .article-body {
    margin-top: 2.5rem;
    font-size: 15px;
    font-family: var(--font-sans);
    font-weight: 400;
    line-height: 2;
    color: var(--color-ink);
    letter-spacing: 0.04em;
  }

  .article-body :global(p) {
    margin-bottom: 1.2rem;
  }

  .article-body :global(h2) {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    margin: 2.5rem 0 1rem;
    letter-spacing: 0.05em;
  }

  .article-body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* 画像は画面に収まる大きさで中央に（ポスターなど縦長の画像が巨大にならないように） */
  .article-body :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 80vh;
    margin: 1.5rem auto;
    border: 1px solid var(--color-line);
  }

  .article-body :global(h3) {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 500;
    margin: 1.8rem 0 0.8rem;
    letter-spacing: 0.06em;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.2rem 1.5rem;
  }

  .article-body :global(table) {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
  }

  .article-body :global(th),
  .article-body :global(td) {
    padding: 0.65rem;
    border-bottom: 1px solid var(--color-line);
    text-align: left;
    vertical-align: top;
  }

  .article-body :global(iframe) {
    width: 100%;
    max-width: 100%;
    min-height: 360px;
    border: 0;
  }

  .article-nav {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .article-nav-item {
    display: block;
    padding: 0.5rem 0;
  }

  .article-nav-item:hover strong {
    color: var(--color-primary);
  }

  .article-nav-item.is-next {
    text-align: right;
  }

  .article-nav-item span {
    display: block;
    font-size: 12px;
    color: var(--color-muted);
    font-family: var(--font-sans);
    letter-spacing: 0.04em;
    margin-bottom: 0.35rem;
  }

  .article-nav-item strong {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
    font-family: var(--font-sans);
    line-height: 1.5;
    letter-spacing: 0.03em;
  }

  @media (max-width: 600px) {
    .article-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
