---
import type { GetStaticPaths } from 'astro';
import Base from '~/layouts/Base.astro';
import { getAllNewsIds, getNewsById, getNews } from '~/libs/microcms';
import { formatDate, excerpt } from '~/libs/format';

export const getStaticPaths = (async () => {
  const ids = await getAllNewsIds();
  return ids.map((id) => ({ params: { id } }));
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const item = id ? await getNewsById(id) : null;

if (!item) {
  return Astro.redirect('/news');
}

// 前後のお知らせ（簡易: 全件取得して位置を探す）
const all = await getNews(100);
const idx = all.findIndex((n) => n.id === item.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;
---

<Base title={item.title} description={excerpt(item.content, 120)} current="/news">
  <article class="article">
    <div class="container article-head">
      <a class="article-back" href="/news">← お知らせ一覧</a>
      <div class="article-meta">
        <span class="news-date">{formatDate(item.publishedAt)}</span>
        <span class="news-tag">
          {Array.isArray(item.category) ? item.category.join('・') : item.category}
        </span>
      </div>
      <h1 class="article-title">{item.title}</h1>
    </div>

    <div class="container">
      <div class="article-body" set:html={item.content}></div>
      {
        !item.content?.includes('<') && item.content ? (
          <div class="article-body">
            {item.content.split('\n').map((line) => (
              <p>{line}</p>
            ))}
          </div>
        ) : null
      }
    </div>

    <nav class="container article-nav">
      {
        prev ? (
          <a class="article-nav-item is-prev" href={`/news/${prev.id}`}>
            <span>前の記事</span>
            <strong>{prev.title}</strong>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="article-nav-item is-next" href={`/news/${next.id}`}>
            <span>次の記事</span>
            <strong>{next.title}</strong>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Base>

<style>
  .article {
    padding: 3rem 0 4rem;
  }

  .article-back {
    display: inline-block;
    font-size: 13px;
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: 0.08em;
    margin-bottom: 2rem;
    padding-bottom: 2px;
    border-bottom: 1px solid currentColor;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .news-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-faint);
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .news-tag {
    font-size: 11px;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    padding: 2px 8px;
    letter-spacing: 0.1em;
    font-family: var(--font-sans);
    font-weight: 500;
  }

  .article-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.1rem);
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1.5;
    color: var(--color-ink);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-line);
    position: relative;
  }

  .article-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 80px;
    height: 2px;
    background: var(--color-primary);
  }

  .article-body {
    margin-top: 2.5rem;
    font-size: 15px;
    font-family: var(--font-sans);
    font-weight: 400;
    line-height: 2;
    color: var(--color-ink);
    letter-spacing: 0.04em;
  }

  .article-body :global(p) {
    margin-bottom: 1.2rem;
  }

  .article-body :global(h2) {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    margin: 2.5rem 0 1rem;
    padding-left: 0.85rem;
    border-left: 3px solid var(--color-primary);
    letter-spacing: 0.08em;
  }

  .article-body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-body :global(img) {
    margin: 1.5rem 0;
    border: 1px solid var(--color-line);
    height: auto;
  }

  .article-body :global(h3) {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 500;
    margin: 1.8rem 0 0.8rem;
    letter-spacing: 0.06em;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.2rem 1.5rem;
  }

  .article-body :global(table) {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
  }

  .article-body :global(th),
  .article-body :global(td) {
    padding: 0.65rem;
    border-bottom: 1px solid var(--color-line);
    text-align: left;
    vertical-align: top;
  }

  .article-body :global(iframe) {
    width: 100%;
    max-width: 100%;
    min-height: 360px;
    border: 0;
  }

  .article-nav {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .article-nav-item {
    display: block;
    padding: 1rem 1.2rem;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .article-nav-item:hover {
    border-color: var(--color-primary);
    background: #fff;
  }

  .article-nav-item.is-next {
    text-align: right;
  }

  .article-nav-item span {
    display: block;
    font-size: 11px;
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: 0.18em;
    margin-bottom: 0.35rem;
    text-transform: uppercase;
  }

  .article-nav-item strong {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
    font-family: var(--font-sans);
    line-height: 1.5;
    letter-spacing: 0.03em;
  }

  @media (max-width: 600px) {
    .article-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
