---
import Base from '~/layouts/Base.astro';
import Paper from '~/components/Paper.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';
import ExhibitionList from '~/components/ExhibitionList.astro';
import PerformanceList from '~/components/PerformanceList.astro';
import { getAllExhibitions, getPerformanceGroups } from '~/libs/microcms';

const [exhibitions, performanceGroups] = await Promise.all([
  getAllExhibitions(),
  getPerformanceGroups(),
]);
const dated = exhibitions.filter((e) => e.startDate);
const undated = exhibitions.filter((e) => !e.startDate);
---

<Base
  title="作品紹介"
  description="京都大学書道部の書展と書道パフォーマンスの記録です。"
  current="/activities"
>
  <PageHeader title="作品紹介" />

  <Paper>
    <Section title="書展">
      <p class="section-lead">
        初夏（鴨夏展）と冬（冬樟展）の年2回、学外で書展を開いています。各回のページからパンフレットを見られます。
      </p>
      <ExhibitionList exhibitions={dated} />

      {
        undated.length > 0 && (
          <>
            <h3 class="sub-heading">そのほかの回</h3>
            <ul class="brochure-list">
              {undated.map((e) => (
                <li>
                  <a href={`/exhibitions/${e.id}`}>{e.title.replace(/\s*書展$/, '')}</a>
                </li>
              ))}
            </ul>
            <p class="note">会期・会場の記録が残っていない回です。パンフレットをご覧いただけます。</p>
          </>
        )
      }
    </Section>

    <Section title="書道パフォーマンス" flush>
      <p class="section-lead">
        これまでに行ってきた書道パフォーマンスの写真や動画です。
      </p>
      <PerformanceList groups={performanceGroups} />
    </Section>
  </Paper>
</Base>

<style>
  .section-lead {
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.9;
    letter-spacing: 0.03em;
    max-width: 48rem;
    margin: 0 0 2rem;
  }

  .sub-heading {
    margin: 3rem 0 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-ink);
  }

  .brochure-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    list-style: none;
  }

  .brochure-list a {
    font-size: 15px;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .brochure-list a:hover {
    text-decoration: none;
  }

  .note {
    margin-top: 1rem;
    font-size: 13px;
    color: var(--color-muted);
  }
</style>
