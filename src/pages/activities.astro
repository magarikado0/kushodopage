---
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import ExhibitionList from '~/components/ExhibitionList.astro';
import PerformanceList from '~/components/PerformanceList.astro';
import { getExhibitions, getPerformances } from '~/libs/microcms';

const [exhibitions, performances] = await Promise.all([
  getExhibitions(100),
  getPerformances(100),
]);
---

<Base
  title="作品紹介"
  description="京都大学書道部の書展と書道パフォーマンスの記録です。"
  current="/activities"
>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-meta">
        <span class="page-hero-label">Archive</span>
        <span class="page-hero-divider" aria-hidden="true"></span>
        <span class="page-hero-en">works &amp; exhibitions</span>
      </div>
      <h1 class="page-hero-title">作品紹介</h1>
    </div>
  </section>

  <Section title="書展" index="01">
    <p class="section-lead">
      各書展のページから、パンフレットとArtoirの作品アーカイブをご覧いただけます。
    </p>
    <ExhibitionList exhibitions={exhibitions} />
  </Section>

  <Section title="書道パフォーマンス" index="02" flush>
    <p class="section-lead">
      NFと新歓で披露してきた書道パフォーマンスの写真や動画をご覧いただけます。
    </p>
    <PerformanceList performances={performances} />
  </Section>
</Base>

<style>
  .page-hero {
    padding: 4rem var(--gutter) 1.8rem;
    border-bottom: 1px solid var(--color-line);
  }

  .page-hero-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
    font-family: var(--font-sans);
  }

  .page-hero-label {
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .page-hero-divider {
    width: 28px;
    height: 1px;
    background: var(--color-line);
  }

  .page-hero-en {
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--color-faint);
    text-transform: uppercase;
  }

  .page-hero-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .section-lead {
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.9;
    letter-spacing: 0.03em;
    max-width: 48rem;
    margin: 0 0 2rem;
  }
</style>
