---
import Base from '~/layouts/Base.astro';
---

<Base title="ページが見つかりません" description="404 Not Found">
  <section class="not-found">
    <div class="container">
      <div class="nf-label">404</div>
      <h1 class="nf-title">お探しのページが見つかりませんでした</h1>
      <p class="nf-body">
        URLが間違っているか、ページが移動・削除されている可能性があります。
      </p>
      <div class="nf-actions">
        <a class="nf-link" href="/">トップページに戻る</a>
        <a class="nf-link is-ghost" href="/news">お知らせを見る</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    padding: 6rem var(--gutter);
    text-align: center;
  }

  .nf-label {
    font-family: var(--font-display);
    font-size: clamp(4rem, 14vw, 7rem);
    font-weight: 600;
    color: var(--color-primary);
    letter-spacing: 0.05em;
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  .nf-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.6rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
    color: var(--color-ink);
  }

  .nf-body {
    font-size: 14px;
    font-family: var(--font-sans);
    font-weight: 400;
    color: var(--color-muted);
    margin-bottom: 2.5rem;
    line-height: 1.9;
    letter-spacing: 0.03em;
  }

  .nf-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .nf-link {
    font-size: 13px;
    color: #fff;
    background: var(--color-primary);
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: 0.12em;
    padding: 0.7rem 1.6rem;
    transition: background 0.2s ease;
  }

  .nf-link.is-ghost {
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
  }

  .nf-link:hover {
    background: var(--color-primary-ink);
  }

  .nf-link.is-ghost:hover {
    background: rgba(155, 35, 53, 0.06);
  }
</style>
