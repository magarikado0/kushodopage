---
import Base from '~/layouts/Base.astro';
---

<Base title="ページが見つかりません" description="404 Not Found">
  <section class="not-found">
    <div class="container">
      <div class="nf-label">404</div>
      <h1 class="nf-title">お探しのページが見つかりませんでした</h1>
      <p class="nf-body">
        URLが間違っているか、ページが移動・削除されている可能性があります。
      </p>
      <div class="nf-actions">
        <a class="nf-link" href="/">トップページに戻る</a>
        <a class="nf-link" href="/news">お知らせを見る</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    padding: 6rem var(--gutter);
    text-align: center;
  }

  .nf-label {
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--color-muted);
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
  }

  .nf-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.6rem);
    font-weight: 500;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    color: var(--color-ink);
  }

  .nf-body {
    font-size: 14px;
    font-family: var(--font-sans);
    font-weight: 400;
    color: var(--color-muted);
    margin-bottom: 2.5rem;
    line-height: 1.9;
    letter-spacing: 0.03em;
  }

  .nf-actions {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .nf-link {
    font-size: 14px;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .nf-link:hover {
    text-decoration: none;
  }
</style>
