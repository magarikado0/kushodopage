---
import type { GetStaticPaths } from 'astro';
import Base from '~/layouts/Base.astro';
import { getAllExhibitions } from '~/libs/microcms';
import { pamphletHref, resolvePamphlet } from '~/libs/pamphlet';
import { formatDateRange, excerpt } from '~/libs/format';

export const getStaticPaths = (async () => {
  const list = await getAllExhibitions();
  return list.map((exhibition) => ({ params: { id: exhibition.id }, props: { exhibition } }));
}) satisfies GetStaticPaths;

const { exhibition } = Astro.props;
const pamphlet = resolvePamphlet(exhibition.id, exhibition.brochureUrl);
const dateRange =
  exhibition.startDate && exhibition.endDate
    ? formatDateRange(exhibition.startDate, exhibition.endDate)
    : '';
---

<Base
  title={exhibition.title}
  description={excerpt(exhibition.description ?? `京都大学書道部 ${exhibition.title}`, 120)}
  current="/activities"
>
  <article class="ex">
    <div class="container ex-head">
      <a class="ex-back" href="/activities">作品紹介に戻る</a>
      <h1 class="ex-title">{exhibition.title}</h1>
      <dl class="ex-info">
        {
          dateRange && (
            <div>
              <dt>会期</dt>
              <dd>{dateRange}</dd>
            </div>
          )
        }
        {
          exhibition.venue && (
            <div>
              <dt>会場</dt>
              <dd>
                {exhibition.venue}
                {exhibition.address ? `（${exhibition.address}）` : ''}
              </dd>
            </div>
          )
        }
      </dl>
    </div>

    {
      exhibition.heroImage?.url && (
        <div class="container ex-hero">
          <img
            src={`${exhibition.heroImage.url}?h=1600&fm=webp`}
            alt={exhibition.heroImage.alt ?? exhibition.title}
            width={exhibition.heroImage.width}
            height={exhibition.heroImage.height}
          />
        </div>
      )
    }

    <div class="container">
      {
        exhibition.description && (
        <div class="ex-body">
          <h2 class="ex-h2">書展について</h2>
          <p>{exhibition.description}</p>
        </div>
        )
      }

      {
        (pamphlet || exhibition.artoirUrl) && (
          <div class="ex-links">
            <h2 class="ex-h2">作品と記録</h2>
            <div class="ex-link-list">
              {exhibition.artoirUrl && (
                <a href={exhibition.artoirUrl} target="_blank" rel="noreferrer">
                  <span>展示作品</span>
                  <strong>Artoirで作品を見る</strong>
                </a>
              )}
              {pamphlet && (
                <a
                  href={pamphletHref(exhibition.id, pamphlet)}
                  {...(pamphlet.kind === 'external' ? { target: '_blank', rel: 'noreferrer' } : {})}
                >
                  <span>書展資料</span>
                  <strong>パンフレットを見る</strong>
                </a>
              )}
            </div>
          </div>
        )
      }
    </div>
  </article>
</Base>

<style>
  .ex {
    padding-bottom: 4rem;
  }

  .ex-head {
    padding-top: 3rem;
  }

  .ex-back {
    display: inline-block;
    font-size: 13px;
    color: var(--color-primary);
    font-family: var(--font-sans);
    letter-spacing: 0.04em;
    margin-bottom: 2rem;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .ex-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-ink);
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-line);
    line-height: 1.3;
  }

  .ex-info {
    font-family: var(--font-sans);
  }

  .ex-info div {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
    padding: 0.5rem 0;
  }

  .ex-info dt {
    font-size: 12px;
    color: var(--color-muted);
    font-size: 13px;
    letter-spacing: 0.04em;
    padding-top: 0.15rem;
  }

  .ex-info dd {
    font-size: 15px;
    color: var(--color-ink);
    font-weight: 400;
  }

  .ex-hero {
    margin-block: 2.5rem;
  }

  /* ポスターは縦長なので切り取らず、全体が画面に収まる大きさで中央に表示する */
  .ex-hero img {
    display: block;
    margin-inline: auto;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 80vh;
    border: 1px solid var(--color-line);
  }

  .ex-body {
    margin-top: 2rem;
  }

  .ex-h2 {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-ink);
    margin-bottom: 1.3rem;
  }

  .ex-body p {
    font-size: 15px;
    font-family: var(--font-sans);
    font-weight: 400;
    line-height: 2;
    color: var(--color-ink);
    letter-spacing: 0.04em;
  }

  .ex-links {
    margin-top: 3rem;
  }

  .ex-link-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .ex-link-list a {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.3rem 1.4rem;
    background: var(--color-paper);
    transition: background 0.2s ease;
  }

  .ex-link-list a:hover {
    background: #fff;
  }

  .ex-link-list span {
    font-size: 12px;
    color: var(--color-muted);
    font-family: var(--font-sans);
    letter-spacing: 0.04em;
  }

  .ex-link-list strong {
    font-size: 15px;
    color: var(--color-primary);
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  @media (max-width: 600px) {
    .ex-link-list {
      grid-template-columns: 1fr;
    }
  }
</style>
