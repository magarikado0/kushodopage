---
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import NewsList from '~/components/NewsList.astro';
import ExhibitionList from '~/components/ExhibitionList.astro';
import { getExhibitions, getNews } from '~/libs/microcms';

const news = await getNews(5);
const exhibitions = await getExhibitions(3);
---

<Base current="/">
  <Hero />

  <Section title="お知らせ" index="01" moreHref="/news">
    <NewsList items={news} showDescription />
  </Section>

  <Section title="書展" index="02" moreHref="/activities" flush>
    <ExhibitionList exhibitions={exhibitions} />
  </Section>
</Base>
